# Required in production. Local development will use a clearly marked dev-only key if this is empty.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local-friendly defaults
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=LexConnect <noreply@lexconnect.local>
DJANGO_PASSWORD_RESET_TIMEOUT=3600
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_SESSION_SAVE_EVERY_REQUEST=False
DEMO_PAYMENT_WEBHOOK_SECRET=
DJANGO_RATELIMIT_ENABLED=True
DJANGO_RATELIMIT_BYPASS_ADMINS=False
LEXCONNECT_OPERATIONAL_EVENT_RETENTION_DAYS=90
LEXCONNECT_READ_NOTIFICATION_RETENTION_DAYS=180
LEXCONNECT_SHOW_DEMO_ACCOUNTS=False
LEXCONNECT_SITE_URL=http://127.0.0.1:8000

# Dedicated admin console (port 9000) — run: python manage.py runadminserver
LEXCONNECT_ADMIN_HOST=127.0.0.1
LEXCONNECT_ADMIN_PORT=9000
LEXCONNECT_ADMIN_URL=http://127.0.0.1:9000/
LEXCONNECT_ADMIN_USERNAME=admin
LEXCONNECT_ADMIN_PASSWORD=admin
LEXCONNECT_ADMIN_EMAIL=admin@lexconnect.local
LEXCONNECT_EMAIL_NOTIFICATIONS=True
LEXCONNECT_EMAIL_NOTIFICATION_TYPES=booking,payment,chat
LEXCONNECT_REMINDERS_ENABLED=True
LEXCONNECT_REMINDER_LOOKAHEAD_HOURS=24
LEXCONNECT_REMINDER_SCAN_LIMIT=100
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=True
CELERY_WORKER_PREFETCH_MULTIPLIER=1
LEXCONNECT_ASYNC_EMAIL=False
LEXCONNECT_ASYNC_NOTIFICATIONS=False
LEXCONNECT_ASYNC_WEBHOOKS=False
PRESENCE_STALE_SCAN_INTERVAL=60
DJANGO_USE_REDIS_CACHE=True

# HTTPS/security settings for production deployments
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_SECURE_PROXY_SSL_HEADER=False
DJANGO_USE_X_FORWARDED_HOST=False
LEXCONNECT_TRUST_PROXY_HEADERS=False
LEXCONNECT_CSP_REPORT_ONLY=False
LEXCONNECT_CSP_DEFAULT_SRC='self'
LEXCONNECT_CSP_SCRIPT_SRC='self','unsafe-inline'
LEXCONNECT_CSP_STYLE_SRC='self','unsafe-inline'
LEXCONNECT_CSP_IMG_SRC='self',data:
LEXCONNECT_CSP_FONT_SRC='self',data:
LEXCONNECT_CSP_CONNECT_SRC='self',ws:,wss:
LEXCONNECT_CSP_OBJECT_SRC='none'
LEXCONNECT_CSP_BASE_URI='self'
LEXCONNECT_CSP_FORM_ACTION='self'
LEXCONNECT_CSP_FRAME_ANCESTORS='none'
DJANGO_LOG_LEVEL=INFO
DJANGO_REQUEST_LOG_LEVEL=INFO
DJANGO_SECURITY_LOG_LEVEL=INFO
DJANGO_AUDIT_LOG_LEVEL=INFO
DJANGO_EMAIL_LOG_LEVEL=INFO
DJANGO_PAYMENT_LOG_LEVEL=INFO
DJANGO_WEBHOOK_LOG_LEVEL=INFO
DJANGO_TASK_LOG_LEVEL=INFO
DJANGO_OPERATION_LOG_LEVEL=INFO
DJANGO_REALTIME_LOG_LEVEL=INFO
DJANGO_DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
DJANGO_STATICFILES_STORAGE=django.contrib.staticfiles.storage.StaticFilesStorage

GEMINI_API_KEY=
LEXORA_GEMINI_MODEL=gemini-2.0-flash
LEXORA_GEMINI_TIMEOUT_MS=5000

# Optional PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Production rehearsal example values:
# DJANGO_SETTINGS_MODULE=lexconnect.settings_production
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<unique-django-secret>
# DEMO_PAYMENT_WEBHOOK_SECRET=<separate-webhook-secret>
# DJANGO_ALLOWED_HOSTS=lexconnect.example.com,www.lexconnect.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://lexconnect.example.com,https://www.lexconnect.example.com
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# LEXCONNECT_SHOW_DEMO_ACCOUNTS=False
